{
  "name": "kurumi-sim",
  "version": "1.0.0",
  "description": "久留美模拟器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "keywords": [],
  "author": "KurumiSim",
  "license": "MIT",
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.kurumi.sim",
    "productName": "久留美模拟器",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.ico",
      "!**/*.map",
      "!**/*.md"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "久留美模拟器.exe",
      "requestExecutionLevel": "user"
    },
    "compression": "maximum",
    "asar": true,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  }
}